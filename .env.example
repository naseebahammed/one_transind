# Server-only configuration template for One Transind.
# Copy to .env.local (never committed) and fill in real values on the server.
# Never prefix secrets with NEXT_PUBLIC_ — doing so inlines them into browser JavaScript.

# PostgreSQL connection
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSL=true

# ERP sales source view/table (and optional YYYY-MM pin)
SALES_TABLE=app.sales_clean
# SALES_PERIOD=

# Optional OpenAI integration for Ask AI (/api/ask)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Authentication (Auth.js + Microsoft Entra ID single-tenant)
# Generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
ADMIN_EMAILS=

# Optional temporary overrides (keep unset in normal production)
# ADMIN_LOGIN_HASH=
# AUTH_DEV_LOGIN=false
# DB_INIT=false
# Set TRUST_PROXY=true only when running behind a reverse proxy (IIS, Nginx, Cloudflare) that sets X-Forwarded-For
# TRUST_PROXY=false


